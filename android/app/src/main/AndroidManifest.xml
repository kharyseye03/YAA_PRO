<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Obligatoire depuis Android 13 pour afficher la notification du
         guidage. Demandée à l'exécution à l'ouverture d'une mission. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <!-- Injectée par le SDK Navigation de Google (7.7.0), retirée ici.
         Elle n'est pas nécessaire au guidage : le SDK tourne dans un
         service de premier plan (FOREGROUND_SERVICE_LOCATION, conservé),
         lancé alors que l'app est visible puisque le coursier tape
         « Démarrer ». Un tel service garde l'accès à la position écran
         éteint sans cette autorisation — documenté par Google depuis la
         version 5.4 du SDK.

         La garder imposerait, sur Google Play, une déclaration de
         localisation en arrière-plan : justification écrite, vidéo, écran
         d'avertissement dans l'app et revue manuelle souvent refusée.

         Limite assumée : un coursier qui met l'app en arrière-plan sans
         avoir lancé le guidage cesse d'émettre sa position. -->
    <uses-permission
        android:name="android.permission.ACCESS_BACKGROUND_LOCATION"
        tools:node="remove"/>

    <!-- Le `android:screenOrientation="portrait"` de MainActivity fait
         déduire à Google Play que l'app *exige* la fonctionnalité
         « écran portrait » : Play l'a aussitôt retirée de 26 appareils
         qui ne tournent qu'en paysage — téléviseurs, bornes, certains
         Chromebooks. Les coursiers n'en utilisent aucun, mais la
         restriction prive aussi d'éventuels installés de leurs mises à
         jour. On déclare donc la fonctionnalité non requise : le verrou
         portrait continue d'agir là où l'appareil sait tourner, et
         aucun appareil n'est écarté du catalogue.

         Le pendant paysage est déclaré pour la même raison, par
         symétrie : aucun écran ne le demande, rien ne doit filtrer
         là-dessus. -->
    <uses-feature
        android:name="android.hardware.screen.portrait"
        android:required="false"/>
    <uses-feature
        android:name="android.hardware.screen.landscape"
        android:required="false"/>
    <application
        android:label="YAA PRO"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        >
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:screenOrientation="portrait"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Impeller, le moteur de rendu par défaut de Flutter, prépare
             ses shaders au lancement. Sur les GPU MediaTek d'entrée de
             gamme il échoue sur Vulkan, retombe sur OpenGL ES, et cette
             préparation bloque le thread principal plusieurs secondes
             avant le premier écran. Le moteur historique démarre
             immédiatement. -->
        <meta-data
            android:name="io.flutter.embedding.android.EnableImpeller"
            android:value="false" />

        <!-- Canal par défaut des notifications reçues quand l'app est
             fermée : Android les affiche lui-même, sans passer par le
             code Dart. Sans ces lignes elles atterrissent dans un canal
             « Divers » et sans icône. La valeur du canal doit rester
             identique à celle de push_service.dart. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="yaa_pro_courses"/>
        <!-- Icône monochrome de la barre d'état. Sans elle, Android
             affiche l'icône de l'app en blanc sur blanc, donc rien. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification"/>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/couleur_notification"/>

        <!-- Clé API Google Maps -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyBUIUFuknenEGOxzRekkzhbyHE6RubvcGE"/>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>

        <!-- Depuis Android 11, une app ne voit que les applications
             qu'elle déclare ici. Sans ces trois entrées, `canLaunchUrl`
             renvoie false et les boutons semblent cassés alors que le
             téléphone sait parfaitement ouvrir un numéro ou un mail.
             tel   : appeler le client, le commerçant, le support
             mailto: écrire au support
             https : ouvrir Google Maps en secours du guidage -->
        <intent>
            <action android:name="android.intent.action.DIAL"/>
            <data android:scheme="tel"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO"/>
            <data android:scheme="mailto"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
