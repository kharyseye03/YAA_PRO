<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- L'app n'a pas de thème sombre : son fond est blanc en toutes
         circonstances. On garde donc un thème clair même quand le
         téléphone est en mode sombre, sinon la fenêtre de lancement
         s'affiche en noir pendant tout le démarrage du moteur avant de
         basculer brutalement sur le blanc de l'application. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@android:color/white</item>
    </style>
</resources>
