<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ : ce fichier remplace `allowBackup` pour les
     sauvegardes cloud et les transferts d'appareil à appareil.

     Tout est exclu. Les préférences de l'app contiennent les jetons de
     session du coursier : les laisser partir dans une sauvegarde
     reviendrait à les rendre extractibles depuis un autre appareil,
     alors qu'ils donnent accès à son compte jusqu'à expiration. Rien
     d'autre n'a besoin d'être restauré — l'app se reconstruit
     entièrement depuis le serveur après une reconnexion. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
