<?xml version="1.0" encoding="utf-8"?>
<!-- Variante API 21+, identique à la version de base. Le fond est fixé
     en blanc plutôt qu'hérité du thème système : l'app n'ayant pas de
     mode sombre, un fond suivant le téléphone donnait un écran noir. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@android:color/white" />

    <item>
        <bitmap
            android:gravity="center"
            android:src="@drawable/launch_logo" />
    </item>
</layer-list>
