<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<!-- Nom affiché sous l'icône, sur l'écran d'accueil et dans les
	     réglages. À ne pas confondre avec CFBundleName, qui est le nom
	     interne du bundle. -->
	<key>CFBundleDisplayName</key>
	<string>YAA PRO</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>yaa_pro</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Conformité à l'exportation : l'app ne chiffre rien elle-même.
	     Ses échanges passent par le TLS du système (HTTPS), y compris
	     ceux de Google Maps et de Firebase, ce qui relève de l'exemption.
	     Sans cette clé, App Store Connect repose la question du
	     chiffrement à chaque téléversement et bloque le build.
	     À réexaminer si une bibliothèque de chiffrement est ajoutée. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<!-- Portrait uniquement, comme main.dart : cette liste-ci régit la
	     rotation avant le démarrage du moteur Flutter, écran de
	     lancement compris. -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<!-- Pas de bloc ~ipad : l'app cible l'iPhone uniquement
	     (TARGETED_DEVICE_FAMILY = 1). Le déclarer compatible iPad
	     obligeait à fournir des captures d'écran iPad et exposait
	     l'app à une vérification sur un appareil pour lequel elle
	     n'est pas conçue. -->
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<!-- Localisation : exigée par CoreLocation et le Navigation SDK.
	     Ces textes sont affichés tels quels dans la demande iOS et lus
	     par App Review : ils doivent dire précisément à quoi sert le GPS. -->
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Votre position permet de vous proposer les courses proches et de vous guider jusqu'au point de récupération puis de livraison.</string>
	<key>NSLocationAlwaysAndWhenInUseUsageDescription</key>
	<string>Votre position permet de poursuivre le guidage et de suivre la livraison même lorsque l'application est en arrière-plan.</string>
	<!-- `location` : guidage maintenu écran éteint ou app en arrière-plan.
	     `remote-notification` : laisse iOS réveiller l'app sur un
	     message silencieux, le temps de rafraîchir la liste des courses
	     avant que le coursier n'ouvre la notification. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>location</string>
		<string>remote-notification</string>
	</array>
</dict>
</plist>
